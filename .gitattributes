* text=auto eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.ico binary
*.woff2 binary

# Binary fixtures over 1 MB live in Git LFS. Large fixtures are generated by script.
fixtures/**/*.pdf filter=lfs diff=lfs merge=lfs -text
fixtures/**/*.png filter=lfs diff=lfs merge=lfs -text
fixtures/**/*.tif filter=lfs diff=lfs merge=lfs -text
fixtures/**/*.docx filter=lfs diff=lfs merge=lfs -text
fixtures/**/*.xlsx filter=lfs diff=lfs merge=lfs -text
fixtures/**/*.pptx filter=lfs diff=lfs merge=lfs -text
